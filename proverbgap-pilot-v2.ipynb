    "# Cell 4: Data Loading\n",
    "PILOT_N = 30\n",
    "LANGUAGES = ['English', 'Yoruba', 'Arabic']\n",
    "dfs = {}\n",
    "input_dir = Path('/kaggle/input')\n",
    "if not input_dir.exists():\n",
    "    input_dir = Path('.')\n",
    "\n",
    "for lang in LANGUAGES:\n",
    "    for p in input_dir.rglob(f'{lang}_cleaned.csv'):\n",
    "        df = pd.read_csv(p).rename(columns={'Source_Text_Yo':'source_proverb', 'Source_Text_Mid':'source_proverb', 'Proverb':'source_proverb', 'source_text':'source_proverb',\n",
    "                                            'Target_Text_En':'proverb_en', 'Translation':'proverb_en', 'english_translation':'proverb_en', 'English_Translation':'proverb_en',\n",
    "                                            'Cultural_Context':'correct_meaning', 'Correct_Meaning':'correct_meaning'})\n",
    "        if lang == 'English':\n",
    "            if 'proverb_en' not in df.columns: df['proverb_en'] = df['source_proverb']\n",
    "            if 'correct_meaning' not in df.columns: df['correct_meaning'] = df['proverb_en']\n",
    "        clean_df = df.dropna(subset=['source_proverb', 'proverb_en', 'correct_meaning'])\n",
    "        if not clean_df.empty:\n",
    "            dfs[lang] = clean_df.sample(min(PILOT_N, len(clean_df)), random_state=42).reset_index(drop=True)\n",
    "            print(f\"Loaded {lang}: {len(dfs[lang])} samples from {p.name}\")\n",
    "            break"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 5: Master Multi-Model Grid Execution Loop (Both Strategies & 5-Model Committee)\n",
    "TASKS, STRATEGIES = ['a', 'b'], ['Strategy_1', 'Strategy_2']\n",
    "COMMITTEE_MODELS = [\n",
    "    'llama-3.1-8b-instant',\n",
    "    'gemma2-9b-it',\n",
    "    'mixtral-8x7b-32768',\n",
    "    'llama-3.3-70b-versatile',\n",
    "    'llama-3.1-70b-versatile'\n",
    "]\n",
    "\n",
    "all_srs_results = []\n",
    "\n",
    "for task_id in TASKS:\n",
    "    for strat_id in STRATEGIES:\n",
    "        print(f\"\\n>>> {task_id.upper()}-{strat_id.upper()}\")\n",
    "        task_rows = []\n",
    "        \n",
    "        for lang, df in dfs.items():\n",
    "            print(f\"[{lang}] Generating...\", end=\" \")\n",
    "            \n",
    "            for i, (_, row) in enumerate(df.iterrows()):\n",
    "                if i % 5 == 0: print(f\"{i}...\", end=\" \", flush=True)\n",
    "                proverb = str(row['source_proverb'])\n",
    "                translation = str(row['proverb_en'])\n",
    "                correct_meaning = str(row['correct_meaning'])\n",
    "                target_text = correct_meaning if task_id == 'b' else translation\n",
    "                \n",
    "                if strat_id == 'Strategy_1':\n",
    "                    # Strategy 1: In-Domain Negative Proverb Sampling\n",
                    "                    candidates = df[df['source_proverb'] != row['source_proverb']]\n",
                    "                    sampled = candidates.sample(3, random_state=42 + i)\n",
                    "                    dists = [str(r['correct_meaning'] if task_id == 'b' else r['proverb_en']) for _, r in sampled.iterrows()]\n",
                    "                    correct_option = target_text\n",
                    "                else:\n",
                    "                    # Strategy 2: LLM Generation + Style-Paraphrasing\n",
                    "                    sys_gen = SYS_B_STRAT2 if task_id == 'b' else SYS_A_STRAT2\n",
                    "                    user_gen = f\"Proverb: {proverb}\\nCorrect Answer: {target_text}\\nReturn JSON.\"\n",
                    "                    raw = generate_distractors_strat2(sys_gen, user_gen, 'llama-3.3-70b-versatile')\n",
                    "                    options = parse_response_strat2(raw)\n",
                    "                    \n",
                    "                    if not options or len(options) < 4:\n",
                    "                        # Fallback to negative sampling if API/parse failed\n",
                    "                        candidates = df[df['source_proverb'] != row['source_proverb']]\n",
                    "                        sampled = candidates.sample(3, random_state=42 + i)\n",
                    "                        dists = [str(r['correct_meaning'] if task_id == 'b' else r['proverb_en']) for _, r in sampled.iterrows()]\n",
                    "                        correct_option = target_text\n",
                    "                    else:\n",
                    "                        correct_option = options[0]\n",
                    "                        dists = options[1:4]\n",
                    "                \n",
                    "                choices, ans = assemble_mcq(correct_option, dists, 42 + i)\n",
                    "                task_rows.append({\n",
                    "                    'task': task_id,\n",
                    "                    'strategy': strat_id,\n",
                    "                    'lang': lang,\n",
                    "                    'source_proverb': proverb,\n",
                    "                    'correct_text': correct_option,\n",
                    "                    'correct_answer': ans,\n",
                    "                    **choices\n",
                    "                })\n",
            print(\"Done\")\n",
            "\n",
            "        df_gen = pd.DataFrame(task_rows)\n",
            "        gen_path = OUT_DIR / f\"pilot_v5_gen_{task_id}_{strat_id.lower()}.csv\"\n",
            "        df_gen.to_csv(gen_path, index=False)\n",
            "        \n",
            "        # ── 5-Model EMNLP Reviewer Committee Audit ──\n",
            "        print(f\"--- AUDITING {task_id.upper()}-{strat_id.upper()} via 5-Model Committee ---\")\n",
            "        target_type = \"translation\" if task_id == 'a' else \"interpretation\"\n",
            "        audit_sys = f\"Reply ONLY with A, B, C, or D. Guess the human {target_type}.\"\n",
            "        \n",
            "        aud_rows = []\n",
            "        for idx, r in df_gen.iterrows():\n",
            "            user_aud = f\"Which is correct?\\nA. {r['Choice_A']}\\nB. {r['Choice_B']}\\nC. {r['Choice_C']}\\nD. {r['Choice_D']}\"\n",
            "            votes = []\n",
            "            item_res = {'lang': r['lang']}\n",
            "            \n",
            "            for model in COMMITTEE_MODELS:\n",
            "                pred = (run_audit(audit_sys, user_aud, model) or \"\").strip().upper()[:1]\n",
            "                if pred not in ['A', 'B', 'C', 'D']: pred = None\n",
            "                item_res[f'hit_{model}'] = int(pred == r['correct_answer']) if pred else 0\n",
            "                if pred: votes.append(pred)\n",
            "                \n",
            "            # Consensus Vote\n",
            "            consensus = max(set(votes), key=votes.count) if votes else None\n",
            "            item_res['hit_consensus'] = int(consensus == r['correct_answer']) if consensus else 0\n",
            "            aud_rows.append(item_res)\n",
            "            \n",
            "        df_aud = pd.DataFrame(aud_rows)\n",
            "        df_aud.to_csv(OUT_DIR / f\"pilot_v5_audit_{task_id}_{strat_id.lower()}.csv\", index=False)\n",
            "        \n",
            "        for lang in LANGUAGES:\n",
            "            sub = df_aud[df_aud['lang']==lang]\n",
            "            if not sub.empty:\n",
            "                srs_consensus = round(sub['hit_consensus'].mean() * 100, 1)\n",
            "                print(f\"{lang:<10} Committee Consensus SRS: {srs_consensus}%\")\n",
            "                all_srs_results.append({\n",
            "                    'Task': task_id, \n",
            "                    'Strat': strat_id, \n",
            "                    'Lang': lang, \n",
            "                    'Consensus': srs_consensus\n",
            "                })\n",
            "\n",
            "print(\"\\n\\nGRID SUMMARY (EMNLP COMMITTEE CONSENSUS):\")\n",
            "final_df = pd.DataFrame(all_srs_results)\n",
            "if not final_df.empty:\n",
            "    pivot = final_df.pivot(index=['Task','Strat'], columns='Lang', values='Consensus')\n",
            "    print(pivot)\n",
            "    pivot.to_csv(OUT_DIR / \"pilot_v5_srs_summary.csv\")"
   ]
  },
